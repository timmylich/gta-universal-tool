{
  "name": "gta-universal-tool",
  "version": "0.1.0",
  "description": "All-in-one modding tool for mobile GTA San Andreas on Android: texture databases (texdb), IMG archives, audio packs, PC mod adaptation.",
  "main": "expo-router/entry",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test:core": "powershell -ExecutionPolicy Bypass -File scripts/test-core.ps1",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "install:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Install"
  },
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "expo-asset": "~57.0.20"
  },
  "author": "timmylich",
  "homepage": "https://github.com/timmylich/gta-universal-tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/timmylich/gta-universal-tool.git"
  },
  "bugs": {
    "url": "https://github.com/timmylich/gta-universal-tool/issues"
  },
  "keywords": [
    "gta",
    "gta-san-andreas",
    "gta-sa-mobile",
    "samp",
    "modding",
    "texdb",
    "txd",
    "img",
    "dff",
    "android",
    "react-native",
    "expo"
  ]
}
